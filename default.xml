<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- This manifest can be used for local development, as a convenient way of
       checking out all the projects needed to build NDK components that are
       built using Kokoro. The http://ab autobuilder doesn't use this manifest,
       and Kokoro itself has its own job config files in google3 for specifying
       which repositories to check out. -->

  <remote  name="aosp"
           fetch=".."
           review="https://android-review.googlesource.com/" />
  <default revision="main"
           remote="aosp"
           sync-j="4" />

  <superproject name="platform/superproject" remote="aosp" revision="ndk-kokoro-main" />

  <project path="external/android-cmake" name="platform/external/android-cmake" revision="mirror-goog-cmake-main-dev-external" />
  <project path="external/bzip2" name="platform/external/bzip2" revision="mirror-goog-main-external" />
  <project path="external/cmake" name="platform/external/cmake" revision="mirror-goog-cmake-main-dev-external" />
  <project path="external/libffi" name="platform/external/libffi" revision="mirror-goog-main-external" />
  <project path="external/ncurses" name="platform/external/ncurses" revision="mirror-goog-main-external" />
  <project path="external/ninja" name="platform/external/ninja" revision="mirror-goog-cmake-main-dev-external" />
  <project path="external/mpdecimal" name="platform/external/mpdecimal" revision="mirror-goog-main-external" />
  <project path="external/python/cpython3" name="platform/external/python/cpython3" revision="mirror-goog-main-external" />
  <project path="external/zlib" name="platform/external/zlib" revision="mirror-goog-main-external" />
  <project path="ndk" name="platform/ndk" revision="mirror-goog-main-ndk" />
  <project path="prebuilts/build-tools" name="platform/prebuilts/build-tools" revision="mirror-goog-main-prebuilts" clone-depth="1" />
  <project path="prebuilts/clang/host/linux-arm64" name="platform/prebuilts/clang/host/linux-arm64" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/cmake/darwin-x86" name="platform/prebuilts/cmake/darwin-x86" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/cmake/linux-arm64" name="platform/prebuilts/cmake/linux-arm64" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/cmake/linux-x86" name="platform/prebuilts/cmake/linux-x86" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/cmake/windows-x86" name="platform/prebuilts/cmake/windows-x86" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/ninja/darwin-x86" name="platform/prebuilts/ninja/darwin-x86" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/ninja/linux-arm64" name="platform/prebuilts/ninja/linux-arm64" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/ninja/linux-x86" name="platform/prebuilts/ninja/linux-x86" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/ninja/windows-x86" name="platform/prebuilts/ninja/windows-x86" revision="mirror-goog-main-prebuilts" />
  <project path="prebuilts/python/darwin-x86" name="platform/prebuilts/python/darwin-x86" revision="mirror-goog-main-llvm-toolchain-source" />
  <project path="prebuilts/python/linux-arm64" name="platform/prebuilts/python/linux-arm64" revision="mirror-goog-main-llvm-toolchain-source" />
  <project path="prebuilts/python/linux-x86" name="platform/prebuilts/python/linux-x86" revision="mirror-goog-main-llvm-toolchain-source" />
  <project path="prebuilts/python/windows-x86" name="platform/prebuilts/python/windows-x86" revision="mirror-goog-main-llvm-toolchain-source" />
  <project path="toolchain/make" name="toolchain/make" revision="mirror-goog-main-tools" />
  <project path="toolchain/ndk-kokoro" name="toolchain/ndk-kokoro" revision="mirror-goog-main-ndk"/>
  <project path="toolchain/xz" name="toolchain/xz" revision="mirror-goog-main-tools" />
  <project path="tools/ndkports" name="platform/tools/ndkports" />
</manifest>
