<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="aosp"
          fetch=".."
          review="https://android-review.googlesource.com/" />
  <default revision="main"
           remote="aosp"
           sync-j="4" />

  <!-- Car App Host and shared AAOS unbundled libraries -->
  <project path="packages/apps/Car/Templates" name="platform/packages/apps/Car/Templates" groups="car-apps-gradle" revision="car-app-host-main" />
  <project path="packages/apps/Car/libs" name="platform/packages/apps/Car/libs" groups="car-apps-gradle" revision="mirror-car-apps-aosp-release" />

  <!-- Android SDK, JDK, and Gradle prebuilts -->
  <project path="prebuilts/sdk" name="platform/prebuilts/sdk" groups="car-apps-gradle" revision="android16-release" clone-depth="1" />
  <project path="prebuilts/jdk/jdk21" name="platform/prebuilts/jdk/jdk21" groups="car-apps-gradle" clone-depth="1" />
  <project path="prebuilts/fullsdk-darwin/platforms" name="platform/prebuilts/fullsdk/platforms" groups="car-apps-gradle" revision="androidx-main" clone-depth="1">
    <linkfile src="." dest="prebuilts/fullsdk-linux/platforms" />
  </project>
  <project path="prebuilts/fullsdk-linux/build-tools" name="platform/prebuilts/fullsdk-linux/build-tools" groups="car-apps-gradle" revision="ub-automotive-main" clone-depth="1" />
  <project path="prebuilts/fullsdk-linux/platform-tools" name="platform/prebuilts/fullsdk-linux/platform-tools" groups="car-apps-gradle" revision="ub-automotive-main" clone-depth="1" />
  <project path="tools/external/gradle" name="platform/tools/external/gradle" groups="car-apps-gradle" revision="androidx-main" clone-depth="1" />

</manifest>
