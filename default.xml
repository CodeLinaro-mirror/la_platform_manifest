<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="aosp"
          fetch=".."
          review="https://android-review.googlesource.com/" />

  <default revision="emu-main-next"
           remote="aosp"
           sync-j="4" />

  <!-- QEMU Core & Dependencies -->
  <project path="third_party/dtc" name="platform/external/dtc" clone-depth="1" />
  <project path="third_party/libpng" name="platform/external/libpng" clone-depth="1" />
  <project path="third_party/mesa3d" name="platform/external/mesa3d" revision="emu-main-dev" />
  <project path="third_party/pixman" name="platform/external/pixman" clone-depth="1" />
  <project path="third_party/qemu" name="platform/external/qemu" revision="emu-main-next-v11.0" />
  <project path="third_party/keycodemapdb" name="trusty/external/qemu-keycodemapdb" clone-depth="1" />
  <project path="third_party/libslirp" name="trusty/external/qemu-libslirp" clone-depth="1" />
  <project path="third_party/wpa_supplicant_8" name="platform/external/wpa_supplicant_8" revision="emu-main-dev" />

  <!-- Graphics (GFXstream & Wayland) -->
  <project path="hardware/google/aemu" name="platform/hardware/google/aemu" />
  <project path="hardware/google/gfxstream" name="platform/hardware/google/gfxstream" revision="emu-main-dev" />
  <project path="third_party/libdrm" name="platform/external/libdrm" clone-depth="1" />
  <project path="third_party/wayland" name="platform/external/wayland" clone-depth="1" />

  <!-- Rutabaga Rust Dependencies -->
  <project path="third_party/rust/android-crates-io" name="platform/external/rust/android-crates-io" clone-depth="1" />
  <project path="third_party/rust/crates/pica" name="platform/external/rust/pica" clone-depth="1" />
  <project path="third_party/rust/rutabaga_gfx" name="platform/external/rust/rutabaga_gfx" clone-depth="1" />

  <!-- Android Emulator Shared Library Plugin & Developer Tools -->
  <project path="hardware/generic/goldfish" name="platform/hardware/generic/goldfish">
    <!-- VS Code Workspace -->
    <linkfile src="development/.vscode" dest=".vscode" />
    <!-- Dev Environment Setup -->
    <linkfile src="development/GLOBAL-PREUPLOAD.cfg" dest="GLOBAL-PREUPLOAD.cfg" />
    <linkfile src="development/mise.toml" dest="mise.toml" />
    <!-- Jetski Custom Agents and Skills -->
    <linkfile src="agents/agents/emu_main_next_documenter" dest=".agents/agents/emu_main_next_documenter" />
    <linkfile src="agents/agents/emu_main_next_engineer" dest=".agents/agents/emu_main_next_engineer" />
    <linkfile src="agents/agents/test_enforcer" dest=".agents/agents/test_enforcer" />
    <linkfile src="agents/skills/amc_build" dest=".agents/skills/amc_build" />
  </project>

  <!-- Crash Reporting Infrastructure -->
  <project path="third_party/google-breakpad" name="platform/external/google-breakpad" clone-depth="1" revision="emu-main-dev" />
  <project path="third_party/crashpad" name="platform/external/crashpad" clone-depth="1" />

  <!-- Media & WebRTC -->
  <project path="third_party/ffmpeg" name="platform/external/ffmpeg" clone-depth="1" />
  <project path="third_party/vulkan-headers" name="platform/external/vulkan-headers" clone-depth="1" revision="main" />
  <project path="third_party/webrtc" name="platform/external/webrtc" clone-depth="1" />

  <!-- Testing & Pytest Infrastructure -->
  <project path="tools/netsim" name="platform/tools/netsim" clone-depth="1" revision="main" />
  <project path="tools/rootcanal" name="platform/tools/rootcanal" clone-depth="1" />
  <project path="third_party/mobly-bundled-snippets" name="platform/external/mobly-bundled-snippets" clone-depth="1" revision="main" />

  <!-- Java JDK & SDK Prebuilt Images -->
  <project path="prebuilts/studio/jdk" name="platform/prebuilts/studio/jdk" clone-depth="1" revision="emu-main-dev" />
  <project path="prebuilts/android" name="platform/prebuilts/android-emulator-build/system-images" clone-depth="1" />

  <!-- Build System & Tooling -->
  <project path="build/bazel" name="platform/build/bazel">
    <linkfile src="toplevel.MODULE.bazel" dest="MODULE.bazel" />
    <linkfile src="toplevel.MODULE.bazel.lock" dest="MODULE.bazel.lock" />
    <linkfile src="toplevel.bazelrc" dest=".bazelrc" />
    <linkfile src="toplevel.bazelversion" dest=".bazelversion" />
  </project>
  <project path="build/make" name="platform/build" clone-depth="1" />
  <project path="third_party/meson" name="trusty/external/qemu-meson" />
  <project path="prebuilts/android-emulator-build/common" name="platform/prebuilts/android-emulator-build/common" clone-depth="1" revision="emu-main-dev" />
  <project path="prebuilts/android-emulator-build/qemu-android-deps" name="platform/prebuilts/android-emulator-build/qemu-android-deps" clone-depth="1" />
  <project path="prebuilts/android-emulator-build/qt" name="platform/prebuilts/android-emulator-build/qt" clone-depth="1" revision="emu-main-dev" />
  <project path="tools/buildSrc" name="platform/tools/buildSrc" />
  <project path="tools/analytics-library" name="platform/tools/analytics-library" revision="studio-main" />

  <!-- Repo Hooks -->
  <project path="tools/repohooks" name="platform/tools/repohooks" groups="developers,tools" />
  <repo-hooks in-project="platform/tools/repohooks" enabled-list="pre-upload" />

  <!-- Host Toolchains (Linux) -->
  <project path="prebuilts/bazel/linux-x86_64" name="platform/prebuilts/bazel/linux-x86_64" clone-depth="1" groups="notdefault,platform-linux" />
  <project path="prebuilts/clang/host/linux-x86" name="platform/prebuilts/clang/host/linux-x86" clone-depth="1" clone-bundle="false" groups="notdefault,platform-linux" />
  <project path="prebuilts/cmake/linux-x86" name="platform/prebuilts/cmake/linux-x86" clone-depth="1" groups="notdefault,platform-linux" />
  <project path="prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8" name="platform/prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8" clone-depth="1" groups="notdefault,platform-linux" />
  <project path="prebuilts/python/linux-x86" name="platform/prebuilts/python/linux-x86" clone-depth="1" groups="notdefault,platform-linux" />

  <!-- Host Toolchains (Windows) -->
  <project path="prebuilts/bazel/windows-x86_64" name="platform/prebuilts/bazel/windows-x86_64" clone-depth="1" groups="notdefault,platform-windows" />
  <project path="prebuilts/clang/host/windows-x86" name="platform/prebuilts/clang/host/windows-x86" clone-depth="1" clone-bundle="false" groups="notdefault,platform-windows" />
  <project path="prebuilts/cmake/windows-x86" name="platform/prebuilts/cmake/windows-x86" clone-depth="1" groups="notdefault,platform-windows" />
  <project path="prebuilts/python/windows-x86" name="platform/prebuilts/python/windows-x86" clone-depth="1" groups="notdefault,platform-windows" />

  <!-- Host Toolchains (Darwin / macOS) -->
  <project path="prebuilts/bazel/darwin-x86_64" name="platform/prebuilts/bazel/darwin-x86_64" clone-depth="1" groups="notdefault,platform-darwin" />
  <project path="prebuilts/clang/host/darwin-x86" name="platform/prebuilts/clang/host/darwin-x86" clone-depth="1" clone-bundle="false" groups="notdefault,platform-darwin" />
  <project path="prebuilts/cmake/darwin-x86" name="platform/prebuilts/cmake/darwin-x86" clone-depth="1" groups="notdefault,platform-darwin" />
  <project path="prebuilts/python/darwin-x86" name="platform/prebuilts/python/darwin-x86" clone-depth="1" groups="notdefault,platform-darwin" />
</manifest>
